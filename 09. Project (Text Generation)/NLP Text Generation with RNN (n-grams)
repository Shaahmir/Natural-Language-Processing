   print(\"Error: No word found\")\n","        return\n","\n","    print(f\"Seed: {seed_text}\")\n","    print(\"Generated text: \", end=\"\")\n","    print(seed_text, end=\"\")\n","\n","    for _ in range(words):\n","        token_list = vectorizer([seed_text])\n","        token_list = tf.keras.preprocessing.sequence.pad_sequences(\n","            token_list.numpy(),\n","            maxlen = max_seq_len - 1,\n","            padding = \"pre\"\n","        )\n","\n","        probabilities = model.predict(token_list, verbose = 0)[0]\n","\n","        logits = np.log(probabilities + 1e-8) / temperature\n","        exp_logits = np.exp(logits)\n","        probs = exp_logits / np.sum(exp_logits)\n","\n","        predicted = np.random.choice(len(probs), p = probs)\n","        generated_word = vocab[predicted]\n","\n","        if generated_word not in ['', '[UNK]']:\n","            print(\" \" + generated_word, end=\"\", flush = True)\n","            seed_text += \" \" + generated_word\n","\n","    print(\"\\n\")"]},{"cell_type":"markdown","metadata":{"id":"Qo8XzHdjX6vL"},"source":["## Generating Results"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"_53lJRxeR9jZ","colab":{"base_uri":"https://localhost:8080/"},"outputId":"3366e829-e5a6-4845-a4be-eadaec5a5e35"},"outputs":[{"output_type":"stream","name":"stdout","text":["Seed: long live the king\n","Generated text: long live the king and so i would not be a\n","\n","Seed: long live the king\n","Generated text: long live the king in stay and fly of my royal eye of day to be the king when he told me to\n","\n","Seed: long live the king\n","Generated text: long live the king of sea playd against my lordship shines agamemnon pistol and honourd than this quirks of peril but like a newmade\n","\n"]}],"source":["generate(\"long live the king\", words = 20, temperature = 0.3)\n","generate(\"long live the king\", words = 20, temperature = 0.7)\n","generate(\"long live the king\", words = 20, temperature = 1.1)"]},{"cell